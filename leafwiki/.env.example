# LeafWiki configuration
# Copy to .env and fill in values
LEAFWIKI_HOST="0.0.0.0"
LEAFWIKI_PORT="8080"
LEAFWIKI_DATA_DIR="/opt/leafwiki/data"
LEAFWIKI_JWT_SECRET=
LEAFWIKI_ADMIN_PASSWORD=
LEAFWIKI_ALLOW_INSECURE="true"
LEAFWIKI_PUBLIC_ACCESS="false"
LEAFWIKI_ENABLE_REVISION="true"
LEAFWIKI_MAX_REVISION_HISTORY="100"
