// Docker-log-source only -- see immich/alloy-config.alloy for why, including
// the shared `host` label name and the "unknown" fallback bucket. Stirling
// PDF's logger emits a clean, unwrapped level token ("HH:MM:SS.mmm [thread]
// LEVEL logger.class - message"), so no ANSI-stripping stage is needed here.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  labels     = { host = "stirling-pdf" }
  forward_to = [loki.process.default.receiver]
}

loki.process "default" {
  forward_to = [loki.write.default.receiver]

  stage.regex {
    expression = "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}\\s+\\[[^\\]]+\\]\\s+(?P<extracted_level>TRACE|DEBUG|INFO|WARN|ERROR)\\s"
  }

  stage.template {
    source   = "extracted_level"
    template = "{{ if eq .Value \"WARN\" }}warning{{ else if .Value }}{{ ToLower .Value }}{{ else }}unknown{{ end }}"
  }

  stage.labels {
    values = { level = "extracted_level" }
  }
}

loki.write "default" {
  endpoint {
    url = "http://monitoring.home:3100/loki/api/v1/push"
  }
}
