auto lo
iface lo inet loopback

iface nic0 inet manual
	# e1000e + this switch renegotiate EEE every ~10s, flapping the link
	# (nic0: NIC Link is Down/Up, zero rx/tx errors) and taking the whole
	# host offline. Disabling EEE on the NIC stops the flap.
	post-up ethtool --set-eee nic0 eee off || true

auto vmbr0
iface vmbr0 inet static
	address 192.168.11.61/24
	gateway 192.168.11.1
	bridge-ports nic0
	bridge-stp off
	bridge-fd 0

iface nic1 inet manual


source /etc/network/interfaces.d/*
