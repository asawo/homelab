auto lo
iface lo inet loopback

iface nic0 inet manual
	post-up ethtool --set-eee nic0 eee off || true
	post-up ethtool -K nic0 tso off gso off || true

auto vmbr0
iface vmbr0 inet static
	address 192.168.8.61/24
	gateway 192.168.8.1
	bridge-ports nic0
	bridge-stp off
	bridge-fd 0
	post-up echo 0 > /sys/class/net/vmbr0/bridge/multicast_snooping

iface nic1 inet manual


source /etc/network/interfaces.d/*
