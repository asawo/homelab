# Monitoring stack configuration
# Copy to .env, fill in values, place at /opt/monitoring/.env on CT 108
# (or `just push-monitoring` will push it there if it exists locally)

# ntfy.sh topic for Alertmanager notifications -- reuses the same topic as
# proxmox/check-storage.env; unauthenticated, so treat the value as a secret
NTFY_TOPIC=

# Proxmox API token for prometheus-pve-exporter.
# Create a dedicated, read-only token bound to the built-in PVEAuditor role
# (Datacenter > Permissions > API Tokens). PVE_API_USER is the bare user
# (e.g. "monitoring@pve"), not the full "user!tokenname" token ID -- the
# token's name itself is hardcoded as "pve-exporter" in docker-compose.yml.
PVE_API_USER=
PVE_API_TOKEN_SECRET=

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=

# AdGuard Home admin credentials, PLAINTEXT -- needed by the exporter's API
# calls. This is a new secret class vs. the password hash already tracked in
# adguard/conf/AdGuardHome.yaml.
ADGUARD_URL=http://adguard.home:80
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
