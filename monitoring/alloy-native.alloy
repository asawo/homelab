// Shared config for the native (non-Docker) Alloy install on Copyparty,
// FileBrowser, and LeafWiki -- see monitoring/setup-alloy-native.sh and
// monitoring/alloy-native.service. Reads each host's own local journal and
// ships it straight to Loki; identical across all three -- loki.source.journal
// doesn't promote journal fields to labels by default (everything comes
// through under a single job=loki.source.journal.local label otherwise,
// making the 3 sources indistinguishable), so relabel_rules explicitly
// promotes _HOSTNAME/_SYSTEMD_UNIT to real "host"/"unit" labels below.
// It also maps journald's own PRIORITY field (syslog severity, present on
// every entry regardless of what the app itself prints) to a baseline
// "level" -- without this, only apps that print their own recognizable level
// text (e.g. LeafWiki's structured JSON) get one; plain-text sources
// (Copyparty, FileBrowser) showed "unknown" otherwise. The loki.process block
// below lets a real structured level (when present) override this fallback.
//
// Replaces an earlier design (systemd-journal-remote/-upload fan-in) that
// hit an unresolved upstream systemd-journal-remote/libmicrohttpd chunked-
// transfer-encoding bug -- see git history for the failed attempt. The host
// itself is deliberately NOT in scope for this: unlike these 3 LXCs, it's
// the bare Proxmox hypervisor, and the whole point of the original
// systemd-journal-upload design was to avoid installing anything extra
// directly on it.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "level"
    regex         = "0|1|2"
    replacement   = "critical"
  }
  rule {
    source_labels = ["__journal_priority"]
    target_label  = "level"
    regex         = "3"
    replacement   = "error"
  }
  rule {
    source_labels = ["__journal_priority"]
    target_label  = "level"
    regex         = "4"
    replacement   = "warning"
  }
  rule {
    source_labels = ["__journal_priority"]
    target_label  = "level"
    regex         = "5|6"
    replacement   = "info"
  }
  rule {
    source_labels = ["__journal_priority"]
    target_label  = "level"
    regex         = "7"
    replacement   = "debug"
  }
}

loki.source.journal "local" {
  forward_to    = [loki.process.journal.receiver]
  relabel_rules = loki.relabel.journal.rules
}

// Apps that emit structured JSON with their own level (e.g. LeafWiki) get
// that preferred over the coarse journald-priority fallback above. Below
// that, two plain-text fallbacks catch severity signals journald's own
// PRIORITY can't see (everything goes to stdout, which journald defaults to
// "info" regardless of content): a bracketed-level regex (e.g. FileBrowser's
// internal scanner logs: "[ERROR] Failed to read root directory...") and an
// HTTP-status-code regex for access-log lines that carry a status but no
// level word at all (e.g. FileBrowser's Gin-style "GET | 500 | ..." --
// 5xx/4xx map to error/warning, everything else stays "info"). Copyparty's
// access log ("LOG: GET / @*") uses neither convention, so it still falls
// through to the journald-priority fallback untouched -- every stage below
// is a no-op on a line that doesn't match, and stage.labels only overwrites
// "level" when a real one was actually extracted.
loki.process "journal" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = { extracted_level = "level" }
  }

  stage.regex {
    expression = "\\[(?P<bracket_level>ERROR|WARN|WARNING|INFO|DEBUG|CRITICAL|FATAL)\\]"
  }

  stage.regex {
    expression = "\\|\\s*(?P<status_code>[1-5]\\d{2})\\s*\\|"
  }

  // Normalize case (and WARN/FATAL naming) so e.g. LeafWiki's own "INFO" and
  // the priority-derived fallback's "info" collapse to one value instead of
  // fragmenting queries. Precedence: JSON-extracted level, then the bracket
  // word, then the HTTP status code (string comparison is safe here since
  // status_code is always exactly 3 digits), then this renders empty and the
  // journald-priority label above is left untouched.
  stage.template {
    source   = "extracted_level"
    template = "{{ if .Value }}{{ ToLower .Value }}{{ else if .bracket_level }}{{ if eq .bracket_level \"WARN\" }}warning{{ else if eq .bracket_level \"FATAL\" }}critical{{ else }}{{ ToLower .bracket_level }}{{ end }}{{ else if .status_code }}{{ if ge .status_code \"500\" }}error{{ else if ge .status_code \"400\" }}warning{{ else }}info{{ end }}{{ else }}{{ end }}"
  }

  stage.labels {
    values = { level = "extracted_level" }
  }
}

loki.write "default" {
  endpoint {
    url = "http://monitoring.home:3100/loki/api/v1/push"
  }
}
