// Docker-log-source only -- keeping this instance's footprint to just the one
// thing that can't be centralized: local Docker socket access. This LXC's own
// journald (as opposed to its Docker containers) isn't currently shipped
// anywhere -- see monitoring/alloy-native.alloy's comment for why the
// journald-shipping design changed.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  labels     = { lxc = "immich" }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://monitoring.home:3100/loki/api/v1/push"
  }
}
