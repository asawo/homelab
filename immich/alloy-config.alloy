// Docker-log-source only -- keeping this instance's footprint to just the one
// thing that can't be centralized: local Docker socket access. This LXC's own
// journald (as opposed to its Docker containers) isn't currently shipped
// anywhere -- see monitoring/alloy-native.alloy's comment for why the
// journald-shipping design changed.
//
// Immich's NestJS logger wraps its level token (LOG/WARN/ERROR/DEBUG) in ANSI
// color codes, so those are stripped before the level regex runs. "LOG" is
// Immich's normal-operation level, mapped to "info" to match the rest of the
// fleet's five-bucket scale (critical/error/warning/info/debug); "WARN" maps
// to "warning" for the same reason. Lines that don't match (e.g. multi-line
// stack traces) get labeled "unknown" rather than left unlabeled. The `host`
// label (shared name with the native-Alloy journal pipeline, so the Logs
// Overview dashboard's Source variable covers both) is a static tag, not a
// discovered value -- this Alloy instance only ever sees this one LXC.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  labels     = { host = "immich" }
  forward_to = [loki.process.default.receiver]
}

loki.process "default" {
  forward_to = [loki.write.default.receiver]

  stage.replace {
    expression = "\\x1b\\[[0-9;]*m"
    replace    = ""
  }

  stage.regex {
    expression = "\\[Nest\\]\\s+\\S+\\s+-\\s+\\S.*?\\s(?P<extracted_level>LOG|WARN|ERROR|DEBUG|VERBOSE)\\s+\\["
  }

  stage.template {
    source   = "extracted_level"
    template = "{{ if eq .Value \"WARN\" }}warning{{ else if eq .Value \"LOG\" }}info{{ else if .Value }}{{ ToLower .Value }}{{ else }}unknown{{ end }}"
  }

  stage.labels {
    values = { level = "extracted_level" }
  }
}

loki.write "default" {
  endpoint {
    url = "http://monitoring.home:3100/loki/api/v1/push"
  }
}
