// Docker-log-source only -- keeping this instance's footprint to just the one
// thing that can't be centralized: local Docker socket access. This LXC's own
// journald (as opposed to its Docker containers) isn't currently shipped
// anywhere -- see monitoring/alloy-native.alloy's comment for why the
// journald-shipping design changed.
//
// Immich's NestJS logger wraps its level token (LOG/WARN/ERROR/DEBUG) in ANSI
// color codes, so those are stripped before the level regex runs. "LOG" is
// Immich's normal-operation level, mapped to "info" to match the rest of the
// fleet's five-bucket scale (critical/error/warning/info/debug); "WARN" maps
// to "warning" for the same reason. Lines that don't match (e.g. multi-line
// stack traces) get labeled "unknown" rather than left unlabeled. The `host`
// label (shared name with the native-Alloy journal pipeline, so the Logs
// Overview dashboard's Source variable covers both) is a static tag, not a
// discovered value -- this Alloy instance only ever sees this one LXC.
//
// Use the purpose-built stage.decolorize, not a manual stage.replace regex --
// verified empirically that a manual stage.replace here does NOT mutate the
// line actually forwarded to Loki (raw ESC bytes still landed in storage,
// confirmed via `repr()` on the stored content), even though its `source`
// defaults to the log line per the docs. stage.decolorize is documented to
// mutate the line directly and was confirmed live to work.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Drop cadvisor's own glog-style stdout and this Alloy instance's own
// key=value control-plane logs -- same noise-filtering rationale as
// adguard/alloy-config.alloy (cadvisor's data already reaches Prometheus as
// metrics). postgres/machine-learning are left in even though they don't
// match either level regex below (bucketing as "unknown") -- unlike
// cadvisor/alloy, they carry real diagnostic value. redis is also left in,
// but gets its own level regex below rather than dumping into "unknown" --
// its periodic RDB-save chatter (every ~5min) was drowning out real signal.
discovery.relabel "filtered" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/immich_(cadvisor|alloy)"
    action        = "drop"
  }

  // Strip the "immich_" prefix off the container name (Docker's own name
  // includes a leading "/") into its own `container` label -- surviving
  // targets are server/postgres/redis/machine_learning. Without this, every
  // container's stream collapsed into the same {host="immich"} label set
  // with no way to filter by service in Explore.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/immich_(.+)"
    target_label  = "container"
    replacement   = "$1"
    action        = "replace"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.filtered.output
  labels     = { host = "immich" }
  forward_to = [loki.process.default.receiver]
}

loki.process "default" {
  forward_to = [loki.write.default.receiver]

  stage.decolorize {}

  stage.regex {
    expression = "\\[Nest\\]\\s+\\S+\\s+-\\s+\\S.*?\\s(?P<extracted_level>LOG|WARN|ERROR|DEBUG|VERBOSE)\\s+\\["
  }

  // Redis's own log format: "<pid>:<M|C|S> <DD Mon YYYY HH:MM:SS.mmm> <char> <msg>",
  // where the single char before the message is Redis's own severity marker:
  // '#' warning, '*' notice, '-'/'.' verbose/debug. Second-tier fallback --
  // only used when the Nest regex above didn't match.
  stage.regex {
    expression = "^\\d+:[MCS]\\s+\\d{2}\\s+\\w+\\s+\\d{4}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d+\\s+(?P<redis_char>[.*#-])\\s"
  }

  // Third-tier: some Nest log calls (e.g. ServerService's startup "Feature
  // Flags: {...}") pretty-print a multi-line JSON object as their message.
  // Docker's json-file driver splits on newlines, so only the FIRST physical
  // line carries the "[Nest]" prefix -- every continuation line is an
  // orphaned fragment with no level marker at all. A proper fix would
  // reconstruct these into one entry via stage.multiline, but its docs don't
  // say whether buffering is per-stream or global, and this pipeline is
  // shared across containers (immich-server/postgres/redis/ml all flow
  // through here) -- risking silently merging unrelated containers' lines
  // felt worse than leaving this as a cosmetic gap. Just recognize the shape
  // (bare `{`/`}` or a `"key":` line) and bucket it as low-priority "debug"
  // instead of alarming "unknown".
  stage.regex {
    expression = "^\\s*(?P<json_continuation>[{}]|\"[^\"]+\"\\s*:)"
  }

  stage.template {
    source   = "extracted_level"
    template = "{{ if .Value }}{{ if eq .Value \"WARN\" }}warning{{ else if eq .Value \"LOG\" }}info{{ else }}{{ ToLower .Value }}{{ end }}{{ else if .redis_char }}{{ if eq .redis_char \"#\" }}warning{{ else if eq .redis_char \"*\" }}info{{ else }}debug{{ end }}{{ else if .json_continuation }}debug{{ else }}unknown{{ end }}"
  }

  stage.labels {
    values = { level = "extracted_level" }
  }
}

loki.write "default" {
  endpoint {
    url = "http://monitoring.home:3100/loki/api/v1/push"
  }
}
