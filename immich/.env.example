# Immich environment variables
# Copy to .env and fill in values

UPLOAD_LOCATION=/mnt/immich/photos
DB_DATA_LOCATION=./postgres
TZ=Asia/Tokyo
IMMICH_VERSION=v3
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Enables immich-server's built-in OpenTelemetry/Prometheus metrics, scraped
# by the monitoring stack (CT 108). Ports below are the same as the compose
# file's defaults -- only override if they collide with something else on
# this LXC. If you DO change either value, you must also manually update the
# matching hardcoded scrape target in monitoring/prometheus/prometheus.yml
# (job "immich", the two `targets:` entries under it) -- nothing templates
# that file from these vars, so a mismatch here silently blackholes those
# metrics from Prometheus without any error. This file is a template only
# (immich/.env is gitignored) -- if you actually need non-default ports on a
# live deployment, update immich/.env on that host directly.
IMMICH_TELEMETRY_INCLUDE=all
IMMICH_API_METRICS_PORT=8081
IMMICH_MICROSERVICES_METRICS_PORT=8082
