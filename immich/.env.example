# Immich environment variables
# Copy to .env and fill in values

UPLOAD_LOCATION=/mnt/immich/photos
DB_DATA_LOCATION=./postgres
TZ=Asia/Tokyo
IMMICH_VERSION=v3
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Enables immich-server's built-in OpenTelemetry/Prometheus metrics, scraped
# by the monitoring stack (CT 108). Ports below are the same as the compose
# file's defaults -- only override if they collide with something else on
# this LXC.
IMMICH_TELEMETRY_INCLUDE=all
IMMICH_API_METRICS_PORT=8081
IMMICH_MICROSERVICES_METRICS_PORT=8082
